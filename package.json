{
  "name": "tirno",
  "version": "0.2.2",
  "description": "Multi-session browser automation CLI on raw CDP — agent self-journaling",
  "keywords": [
    "cdp",
    "chrome-devtools-protocol",
    "puppeteer",
    "browser-automation",
    "cli",
    "multi-session",
    "agent",
    "a11y"
  ],
  "type": "module",
  "bin": {
    "tirno": "./bin/tirno.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rockheung/tirno.git"
  },
  "homepage": "https://github.com/Rockheung/tirno#readme",
  "bugs": {
    "url": "https://github.com/Rockheung/tirno/issues"
  },
  "author": "Rockheung <rockheung@gmail.com>",
  "license": "ISC",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "start": "node bin/tirno.js",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "lighthouse": "^12.8.2",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.2"
  }
}
